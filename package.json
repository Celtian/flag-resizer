{
  "name": "@celtian/flag-resizer",
  "version": "0.0.0",
  "private": false,
  "description": "Generate typed, optimized PNG and WebP country flag assets from Twemoji SVGs.",
  "keywords": [
    "flags",
    "cli",
    "sharp",
    "png",
    "webp",
    "typescript"
  ],
  "author": {
    "name": "Dominik Hladík",
    "email": "dominik.hladik@seznam.cz",
    "url": "https://github.com/Celtian"
  },
  "license": "MIT AND CC-BY-4.0",
  "homepage": "https://github.com/Celtian/flag-resizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Celtian/flag-resizer.git"
  },
  "bugs": {
    "url": "https://github.com/Celtian/flag-resizer/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "bun@1.3.14",
  "bin": {
    "flag-resizer": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "flags",
    "ATTRIBUTION.txt",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-GRAPHICS",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.only",
    "test:coverage": "vitest run --coverage",
    "package:check": "bun ./scripts/check-package.ts",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test:coverage && bun run test:types && bun run build && bun run package:check",
    "script:package-github": "bun ./scripts/package-github.ts",
    "prepare": "husky",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check",
    "preversion": "bun run check",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "postversion": "git push && git push --follow-tags",
    "publish:beta": "bun ci && bun run check && npm publish --ignore-scripts --tag beta",
    "release:beta": "git checkout master && npm version prerelease --preid=beta -m \"chore(update): prerelease %s β\"",
    "release:patch": "git checkout master && npm version patch -m \"chore(update): patch release %s 🐛\"",
    "release:minor": "git checkout master && npm version minor -m \"chore(update): release %s 🚀\"",
    "release:major": "git checkout master && npm version major -m \"chore(update): major release %s 💥\"",
    "fix-vulnerabilities": "bun update && bun audit"
  },
  "dependencies": {
    "c12": "^3.3.4",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "auto-changelog": "^2.6.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "quick-commitlint": "^0.1.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "auto-changelog": {
    "remote": "none",
    "commitUrl": "https://github.com/Celtian/flag-resizer/commit/{id}",
    "issueUrl": "https://github.com/Celtian/flag-resizer/issues/{id}",
    "mergeUrl": "https://github.com/Celtian/flag-resizer/pull/{id}",
    "compareUrl": "https://github.com/Celtian/flag-resizer/compare/{from}...{to}"
  }
}
